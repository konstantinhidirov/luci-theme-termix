{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');
	const configuredMode = uci.get('termix', 'settings', 'mode');
	const themeMode = configuredMode == 'light' || configuredMode == 'system' ? configuredMode : 'dark';
	const darkpref = themeMode == 'system' ? null : (themeMode == 'dark' ? 'true' : 'false');
	const configuredAccent = uci.get('termix', 'settings', 'accent');
	const accents = { orange: true, blue: true, green: true, purple: true, pink: true, cyan: true, red: true, yellow: true, teal: true, indigo: true, rose: true, lime: true, matrix: true, custom: true };
	const accent = accents[configuredAccent] ? configuredAccent : 'orange';
	const mxNum = (name, lo, hi, def) => {
        const raw = uci.get('termix', 'settings', name);
        const n = match(raw ?? '', /^[0-9]+$/) ? int(raw) : def;
        return n < lo ? lo : (n > hi ? hi : n);
    };
    const mxFx = uci.get('termix', 'settings', 'matrix_fx') == 'on' ? 'on' : 'off';
    const mxGlow = uci.get('termix', 'settings', 'matrix_glow') == 'off' ? 'off' : 'on';
    const mxScanlines = uci.get('termix', 'settings', 'scanlines') == 'off' ? 'off' : 'on';
    const mxAreaRaw = uci.get('termix', 'settings', 'rain_area');
    const mxArea = mxAreaRaw == 'main' || mxAreaRaw == 'chrome' || mxAreaRaw == 'none' ? mxAreaRaw : 'all';
    const mxSaturation = mxNum('matrix_intensity', 0, 100, 100);
    const mxInterval = mxNum('rain_interval', 40, 250, 100);
    const mxSize = mxNum('rain_size', 12, 32, 20);
    const mxOpacity = mxNum('rain_opacity', 0, 35, 13);
	const configuredColor = uci.get('termix', 'settings', 'custom_accent') ?? '';
	const customColor = accent == 'custom' && match(configuredColor, /^#[0-9a-fA-F]{6}$/) ? configuredColor : '#f59145';
	const red = int(substr(customColor, 1, 2), 16);
	const green = int(substr(customColor, 3, 2), 16);
	const blue = int(substr(customColor, 5, 2), 16);
	const onCustomColor = red * 299 + green * 587 + blue * 114 > 150000 ? '#181916' : '#ffffff';

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-termix-accent="{{ accent }}" data-mx-fx="{{ mxFx }}" data-mx-glow="{{ mxGlow }}" data-mx-scanlines="{{ mxScanlines }}" data-mx-rain-area="{{ mxArea }}" data-mx-rain-interval="{{ mxInterval }}" data-mx-rain-size="{{ mxSize }}" data-mx-rain-opacity="{{ mxOpacity }}" {{ darkpref ? `data-darkmode="${darkpref}"` : '' }} {{ accent == 'custom' ? `style="--primary-color-high:${customColor};--on-primary-color:${onCustomColor}"` : '' }}>
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		{% if (!darkpref): %}
			<script>
				var mediaQuery = window.matchMedia('(prefers-color-scheme: dark)'),
				    rootElement = document.querySelector(':root'),
				    setDarkMode = function(match) { rootElement.setAttribute('data-darkmode', match.matches) };

				mediaQuery.addEventListener('change', setDarkMode);
				setDarkMode(mediaQuery);
			</script>
		{% endif %}
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<link rel="stylesheet" href="{{ media }}/cascade.css?v=1">
		<link rel="stylesheet" media="only screen and (max-width: 854px)" href="{{ media }}/mobile.css?v=2" />
		<link rel="stylesheet" href="{{ media }}/termix.css?v=0.2.0-rc1.4">
		<style>:root{--mx-saturation:{{ mxSaturation }}%;--mx-rain-op:calc({{ mxOpacity }} / 100)}</style>
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js?v=26.180.75667~128a781"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<header>
			<div class="termix-brand"><span class="termix-brand-icon">▤</span><span>OPENWRT<small>CONTROL PANEL</small></span><button id="termix-menu-close" type="button" aria-label="{{ _('Close') }}">×</button></div>
			<ul class="nav" id="topmenu" style="display:none"></ul>
		</header>
		<button id="termix-menu-backdrop" type="button" aria-label="{{ _('Close') }}"></button>
		<div class="termix-topbar"><button id="termix-menu-toggle" type="button" aria-label="Toggle navigation"></button><span class="termix-topbar-host">{{ striptags(boardinfo.hostname ?? '?') }}</span><span class="termix-topbar-divider">/</span><span class="termix-topbar-title">{{ _(dispatched?.title ?? _('Overview')) }}</span><div id="indicators"></div></div>

		<div id="maincontent" class="container">
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="alert-message warning">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			{% if (boardinfo.rootfs_type == "initramfs"): %}
				<div class="alert-message warning">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup("admin/system/flash")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
				</div>
			</noscript>

			<div id="tabmenu" style="display:none"></div>
		{% endif %}
