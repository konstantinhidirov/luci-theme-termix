		{% if (!blank_page): %}
		</div>
		<footer>
			<span class="termix-footer-full">
				Powered by
				<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">
					{{ version.luciname }} ({{ version.luciversion }})</a>
				/
				<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">
					{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
				{% if (lua_active): %}
					/ {{ _('Lua compatibility mode active') }}
				{% endif %}
			</span>
			<span class="termix-footer-compact">Powered by <a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">LuCI</a> / <a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }}</a></span>
			<ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
		</footer>
		<script>L.require('menu-bootstrap')</script>
		<script src="{{ media }}/termix.js?v=4"></script>
		{% endif %}
		{% if (uci.get('termix', 'settings', 'matrix_fx') == 'on'): %}<script src="{{ media }}/matrix.js?v=0.2.0"></script>{% endif %}
	</body>
</html>
